# ==============================================================================
# SignalLead PL — Szablon zmiennych środowiskowych (skopiuj do .env lub Railway/Render)
# ==============================================================================

# --- 1. Podstawy i bezpieczeństwo panelu admina ---
# Publiczny adres Twojej aplikacji (bez ukośnika na końcu) — używany w linkach /pack/{id} i Stripe
PUBLIC_BASE_URL=https://twojadomena.pl

# Trwała ścieżka bazy SQLite (na Railway/Render podepnij wolumen /data)
SIGNALLEAD_DB_PATH=/data/signallead.db

# Zabezpieczenie panelu admina (/) i API (/api/leads, /api/buyers, /api/outreach).
# UWAGA: Zostaw puste lokalnie, ale OBOWIĄZKOWO ustaw na produkcji,
# żeby agencje wchodzące na /pack/{id} nie miały dostępu do Twojej pełnej bazy!
ADMIN_USER=admin
ADMIN_PASSWORD=ustaw-silne-haslo-produkcyjne

# --- 2. Stripe Checkout (PLN bez VAT · BLIK · Karta · Przelewy24 · NIP) ---
# Zostaw puste, aby korzystać z lokalnego Trybu Testowego (Sandbox).
# Na start możesz użyć kluczy testowych sk_test_..., a po weryfikacji zmienić na sk_live_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- 3. Automat Wysyłkowy (Outreach Mailer — Specjalista #8) ---
# Zostaw puste, aby korzystać z Trybu Sandbox.
# Opcja A (zalecana w chmurze Railway / Render): Resend API
RESEND_API_KEY=
MAIL_FROM=Eryk <kontakt@twojadomena.pl>
MAIL_REPLY_TO=kontakt@twojadomena.pl

# Opcja B (alternatywa dla Resend): Dowolny serwer SMTP (OVH / cyber_Folks / Zoho / Google Workspace)
# SMTP_HOST=smtp.twojadomena.pl
# SMTP_PORT=587
# SMTP_USER=kontakt@twojadomena.pl
# SMTP_PASSWORD=
# SMTP_USE_SSL=false

# Bezpieczne limity anty-spamowe (chronią reputację domeny przed folderem SPAM)
DAILY_SEND_LIMIT=20
OUTREACH_COOLDOWN_DAYS=7
